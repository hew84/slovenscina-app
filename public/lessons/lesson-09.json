    {
      "id": "d-rojstni-dan",
      "type": "dialog",
      "title": "Einladung zum Geburtstag",
      "speakers": ["Sara", "Tim"],
      "lines": [
        { "speaker": "Sara", "sl": "Tim, v soboto praznujem rojstni dan. {{0}} te na zabavo!", "answer": "Vabim", "distractor": "Vabiš", "de": "Tim, am Samstag feiere ich Geburtstag. Ich lade dich zur Party ein!" },
        { "speaker": "Tim", "sl": "Super, hvala! Ob kateri uri?", "de": "Super, danke! Um wie viel Uhr?" },
        { "speaker": "Sara", "sl": "Ob osmih. Pridejo tudi Maja, Luka in moj {{0}}.", "answer": "brat", "distractor": "brata", "de": "Um acht. Maja, Luka und mein Bruder kommen auch." },
        { "speaker": "Tim", "sl": "Kaj si želiš za darilo?", "de": "Was wünschst du dir als Geschenk?" },
        { "speaker": "Sara", "sl": "Nič, samo pridi! In prinesi dobro {{0}}.", "answer": "glasbo", "distractor": "glasba", "de": "Nichts, komm einfach! Und bring gute Musik mit." },
        { "speaker": "Tim", "sl": "Velja. Se vidiva v soboto!", "de": "Abgemacht. Bis Samstag!" }
      ]
    },
    {
      "id": "d-album",
      "type": "dialog",
      "title": "Das Familienalbum",
      "speakers": ["Eva", "Nik"],
      "lines": [
        { "speaker": "Eva", "sl": "Kdo je to na sliki?", "de": "Wer ist das auf dem Bild?" },
        { "speaker": "Nik", "sl": "To je moja {{0}}, Ana. Stara je deset let.", "answer": "hčerka", "distractor": "sin", "de": "Das ist meine Tochter Ana. Sie ist zehn Jahre alt." },
        { "speaker": "Eva", "sl": "Kako je lepa! Ima dolge svetle lase.", "de": "Wie hübsch sie ist! Sie hat lange helle Haare." },
        { "speaker": "Nik", "sl": "Ja, in modre oči, kot njena {{0}}.", "answer": "mama", "distractor": "oče", "de": "Ja, und blaue Augen, wie ihre Mama." },
        { "speaker": "Eva", "sl": "In ta fant?", "de": "Und dieser Junge?" },
        { "speaker": "Nik", "sl": "To je moj sin Jure. Rad igra nogomet in ima {{0}} psa.", "answer": "velikega", "distractor": "velik", "de": "Das ist mein Sohn Jure. Er spielt gern Fußball und hat einen großen Hund." },
        { "speaker": "Eva", "sl": "Imaš res lepo družino!", "de": "Du hast wirklich eine schöne Familie!" }
      ]
    },
    {
      "id": "d-zabava",
      "type": "dialog",
      "title": "Auf der Hochzeitsfeier",
      "speakers": ["Gospod Horvat", "Gospa Zupan"],
      "lines": [
        { "speaker": "Gospod Horvat", "sl": "Dober večer, gospa Zupan. Ali {{0}} plešete?", "answer": "radi", "distractor": "rad", "de": "Guten Abend, Frau Zupan. Tanzen Sie gern?" },
        { "speaker": "Gospa Zupan", "sl": "Ja, zelo. Ampak danes me boli {{0}}.", "answer": "noga", "distractor": "nogo", "de": "Ja, sehr. Aber heute tut mir das Bein weh." },
        { "speaker": "Gospod Horvat", "sl": "Škoda. Potem pa na zdravje!", "de": "Schade. Dann eben: Prost!" },
        { "speaker": "Gospa Zupan", "sl": "Na zdravje! Ali poznate Majo in Tima?", "de": "Prost! Kennen Sie Maja und Tim?" },
        { "speaker": "Gospod Horvat", "sl": "Ja, Tima {{0}} že dolgo.", "answer": "poznam", "distractor": "pozna", "de": "Ja, Tim kenne ich schon lange." },
        { "speaker": "Gospa Zupan", "sl": "Lep par sta. Vse {{0}} jima!", "answer": "najboljše", "distractor": "najboljši", "de": "Sie sind ein schönes Paar. Alles Gute für die beiden!" }
      ]
    }
  ]
