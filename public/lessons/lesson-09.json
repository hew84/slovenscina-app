    { "id": "ch-ga", "type": "choice", "text": "Kje je moj telefon? – Ne vem, ne vidim {{0}}.", "answer": "ga", "distractor": "jo", "translation": "Wo ist mein Handy? – Ich weiß nicht, ich sehe es nicht." },
    { "id": "ch-vas", "type": "choice", "text": "Gospa Novak, lahko {{0}} povabim na kavo?", "answer": "vas", "distractor": "te", "translation": "Frau Novak, darf ich Sie auf einen Kaffee einladen?" },
