    {
      "id": "d-kavarna",
      "type": "dialog",
      "title": "Im Café",
      "speakers": ["Natakarica", "Marko"],
      "lines": [
        { "speaker": "Natakarica", "sl": "Dober dan. Kaj boste?", "de": "Guten Tag. Was nehmen Sie?" },
        { "speaker": "Marko", "sl": "Kavo z {{0}}, prosim.", "answer": "mlekom", "distractor": "mleko", "de": "Einen Kaffee mit Milch, bitte." },
        { "speaker": "Natakarica", "sl": "Še kaj?", "de": "Sonst noch etwas?" },
        { "speaker": "Marko", "sl": "Ja. Kaj {{0}} za sladico?", "answer": "priporočate", "distractor": "priporočaš", "de": "Ja. Was empfehlen Sie als Nachspeise?" },
        { "speaker": "Natakarica", "sl": "Priporočam čokoladno torto. Je zelo okusna.", "de": "Ich empfehle die Schokoladentorte. Sie ist sehr lecker." },
        { "speaker": "Marko", "sl": "Dobro, jaz bom {{0}}.", "answer": "torto", "distractor": "torta", "de": "Gut, ich nehme die Torte." },
        { "speaker": "Natakarica", "sl": "Izvolite.", "de": "Bitte schön." },
        { "speaker": "Marko", "sl": "Hvala. Račun, prosim. Koliko {{0}} vse skupaj?", "answer": "stane", "distractor": "stanejo", "de": "Danke. Die Rechnung, bitte. Was kostet alles zusammen?" },
        { "speaker": "Natakarica", "sl": "Šest evrov štirideset.", "de": "Sechs Euro vierzig." },
        { "speaker": "Marko", "sl": "Izvolite. Je že v redu.", "de": "Bitte schön. Stimmt so." }
      ]
    },
    {
      "id": "d-povabilo",
      "type": "dialog",
      "title": "Eine Einladung",
      "speakers": ["Jan", "Tina"],
      "lines": [
        { "speaker": "Jan", "sl": "Tina, greva na pijačo?", "de": "Tina, gehen wir etwas trinken?" },
        { "speaker": "Tina", "sl": "Zdaj žal ne, imam izpit. Gremo zvečer na {{0}}?", "answer": "pico", "distractor": "pica", "de": "Jetzt leider nicht, ich habe eine Prüfung. Gehen wir am Abend Pizza essen?" },
        { "speaker": "Jan", "sl": "Ja, z veseljem! Kje?", "de": "Ja, gerne! Wo?" },
        { "speaker": "Tina", "sl": "V piceriji Napoli. Tam je pica zelo {{0}}.", "answer": "dobra", "distractor": "dober", "de": "In der Pizzeria Napoli. Dort ist die Pizza sehr gut." },
        { "speaker": "Jan", "sl": "In poceni?", "de": "Und billig?" },
        { "speaker": "Tina", "sl": "Ja, ni {{0}}.", "answer": "draga", "distractor": "drag", "de": "Ja, sie ist nicht teuer." },
        { "speaker": "Jan", "sl": "Odlično. Se vidiva zvečer!", "de": "Ausgezeichnet. Bis heute Abend!" }
      ]
    },
    {
      "id": "d-trgovina",
      "type": "dialog",
      "title": "Einkaufen",
      "speakers": ["Ana", "Prodajalka"],
      "lines": [
        { "speaker": "Ana", "sl": "Dober dan. Koliko stane ta sir?", "de": "Guten Tag. Wie viel kostet dieser Käse?" },
        { "speaker": "Prodajalka", "sl": "Štiri {{0}} dvajset.", "answer": "evre", "distractor": "evrov", "de": "Vier Euro zwanzig." },
        { "speaker": "Ana", "sl": "Dobro. Potrebujem še kruh in {{0}}.", "answer": "salamo", "distractor": "salama", "de": "Gut. Ich brauche noch Brot und Salami." },
        { "speaker": "Prodajalka", "sl": "Izvolite. Še kaj?", "de": "Bitte schön. Sonst noch etwas?" },
        { "speaker": "Ana", "sl": "Ne, hvala. Koliko stane vse skupaj?", "de": "Nein, danke. Was kostet alles zusammen?" },
        { "speaker": "Prodajalka", "sl": "Devet evrov petdeset. Imate drobiž?", "de": "Neun Euro fünfzig. Haben Sie Kleingeld?" },
        { "speaker": "Ana", "sl": "Žal ne. Lahko {{0}} s kartico?", "answer": "plačam", "distractor": "plačate", "de": "Leider nicht. Kann ich mit Karte bezahlen?" },
        { "speaker": "Prodajalka", "sl": "Seveda.", "de": "Natürlich." }
      ]
    }
  ]
