    {
      "id": "d-ogled",
      "type": "dialog",
      "title": "Eine Wohnung mieten",
      "speakers": ["Jan", "Lastnica"],
      "lines": [
        { "speaker": "Jan", "sl": "Dober dan. Kličem zaradi oglasa za stanovanje.", "de": "Guten Tag. Ich rufe wegen der Anzeige für die Wohnung an." },
        { "speaker": "Lastnica", "sl": "Ja, dvosobno stanovanje v tretjem {{0}}.", "answer": "nadstropju", "distractor": "nadstropje", "de": "Ja, eine Zweizimmerwohnung im dritten Stock." },
        { "speaker": "Jan", "sl": "Je v bloku tudi dvigalo?", "de": "Gibt es im Haus auch einen Aufzug?" },
        { "speaker": "Lastnica", "sl": "Žal ne, dvigala {{0}}.", "answer": "nimamo", "distractor": "imamo", "de": "Leider nein, einen Aufzug haben wir nicht." },
        { "speaker": "Jan", "sl": "Ni problema. Je stanovanje opremljeno?", "de": "Kein Problem. Ist die Wohnung möbliert?" },
        { "speaker": "Lastnica", "sl": "Ja, ima kavč, posteljo in omaro. Samo televizije {{0}}.", "answer": "ni", "distractor": "je", "de": "Ja, es gibt ein Sofa, ein Bett und einen Schrank. Nur einen Fernseher gibt es nicht." },
        { "speaker": "Jan", "sl": "Koliko stane?", "de": "Wie viel kostet sie?" },
        { "speaker": "Lastnica", "sl": "Štiristo evrov na mesec, stroški so petdeset evrov.", "de": "Vierhundert Euro im Monat, die Nebenkosten sind fünfzig Euro." },
        { "speaker": "Jan", "sl": "Kdaj {{0}} lahko vidim?", "answer": "ga", "distractor": "jo", "de": "Wann kann ich sie mir ansehen?" },
        { "speaker": "Lastnica", "sl": "Jutri popoldne, ob petih.", "de": "Morgen Nachmittag, um fünf." }
      ]
    },
    {
      "id": "d-soba",
      "type": "dialog",
      "title": "Das neue Zimmer",
      "speakers": ["Eva", "Maja"],
      "lines": [
        { "speaker": "Eva", "sl": "Kakšna je tvoja nova soba?", "de": "Wie ist dein neues Zimmer?" },
        { "speaker": "Maja", "sl": "Majhna, ampak zelo {{0}}.", "answer": "svetla", "distractor": "svetlo", "de": "Klein, aber sehr hell." },
        { "speaker": "Eva", "sl": "Kaj imaš v sobi?", "de": "Was hast du im Zimmer?" },
        { "speaker": "Maja", "sl": "Na levi je postelja, na desni {{0}}.", "answer": "omara", "distractor": "omaro", "de": "Links steht das Bett, rechts der Schrank." },
        { "speaker": "Eva", "sl": "In pisalna miza?", "de": "Und ein Schreibtisch?" },
        { "speaker": "Maja", "sl": "Ta je na sredini. Ampak zdaj sem brez {{0}}. Grozno!", "answer": "interneta", "distractor": "internet", "de": "Der steht in der Mitte. Aber gerade bin ich ohne Internet. Schrecklich!" },
        { "speaker": "Eva", "sl": "Joj! Potem pridi k meni na kavo.", "de": "Oje! Dann komm zu mir auf einen Kaffee." }
      ]
    },
    {
      "id": "d-problem",
      "type": "dialog",
      "title": "Ein Problem in der Wohnung",
      "speakers": ["Gospod Kralj", "Lastnik"],
      "lines": [
        { "speaker": "Gospod Kralj", "sl": "Dober dan. Imam problem: hladilnik ne {{0}}.", "answer": "dela", "distractor": "delam", "de": "Guten Tag. Ich habe ein Problem: Der Kühlschrank funktioniert nicht." },
        { "speaker": "Lastnik", "sl": "Joj. Ga lahko pogledam jutri dopoldne?", "de": "Oje. Kann ich ihn mir morgen Vormittag ansehen?" },
        { "speaker": "Gospod Kralj", "sl": "Jutri dopoldne nisem {{0}}.", "answer": "doma", "distractor": "dom", "de": "Morgen Vormittag bin ich nicht zu Hause." },
        { "speaker": "Lastnik", "sl": "Potem pa popoldne, ob štirih?", "de": "Dann am Nachmittag, um vier?" },
        { "speaker": "Gospod Kralj", "sl": "V redu. In še nekaj: v kopalnici ni {{0}}.", "answer": "luči", "distractor": "luč", "de": "In Ordnung. Und noch etwas: Im Bad gibt es kein Licht." },
        { "speaker": "Lastnik", "sl": "Prinesem novo žarnico.", "de": "Ich bringe eine neue Glühbirne." },
        { "speaker": "Gospod Kralj", "sl": "Najlepša hvala!", "de": "Vielen herzlichen Dank!" }
      ]
    }
  ]
