      "speakers": ["Tajnica", "Gospod Rozman"],
      "lines": [
        { "speaker": "Tajnica", "sl": "Agencija Sonce, prosim?", "de": "Agentur Sonce, bitte?" },
        { "speaker": "Gospod Rozman", "sl": "Dober dan, Rozman tukaj. A lahko {{0}} gospo Novak?", "answer": "dobim", "distractor": "dobite", "de": "Guten Tag, hier Rozman. Kann ich Frau Novak sprechen?" },
