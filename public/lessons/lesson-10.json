        { "speaker": "Nina", "sl": "Študirala sem na {{0}} v Gradcu.", "answer": "univerzi", "distractor": "univerza", "de": "Ich habe an der Universität in Graz studiert." },
        { "speaker": "Luka", "sl": "Super! In zdaj?", "de": "Super! Und jetzt?" },
