        { "speaker": "Nina", "sl": "Ja, sodelavci so prijazni, ampak plača je {{0}}.", "answer": "nizka", "distractor": "nizek", "de": "Ja, die Kollegen sind nett, aber das Gehalt ist niedrig." }
      ]
