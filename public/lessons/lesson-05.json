    {
      "id": "d-ne-razumem",
      "type": "dialog",
      "title": "Ich verstehe nicht",
      "speakers": ["Učiteljica", "Tom"],
      "lines": [
        { "speaker": "Učiteljica", "sl": "Dober dan. Odprite delovni zvezek na strani osem.", "de": "Guten Tag. Öffnen Sie das Arbeitsheft auf Seite acht." },
        { "speaker": "Tom", "sl": "Oprostite, ne {{0}}. A lahko ponovite?", "answer": "razumem", "distractor": "razume", "de": "Entschuldigung, ich verstehe nicht. Können Sie das wiederholen?" },
        { "speaker": "Učiteljica", "sl": "Seveda. Delovni zvezek, stran osem.", "de": "Natürlich. Arbeitsheft, Seite acht." },
        { "speaker": "Tom", "sl": "Hvala. Kaj {{0}} »zvezek«?", "answer": "pomeni", "distractor": "pomenim", "de": "Danke. Was bedeutet »zvezek«?" },
        { "speaker": "Učiteljica", "sl": "Po nemško je to »Heft«.", "de": "Auf Deutsch ist das »Heft«." },
        { "speaker": "Tom", "sl": "Aha, zdaj {{0}}!", "answer": "razumem", "distractor": "razumete", "de": "Ach so, jetzt verstehe ich!" },
        { "speaker": "Učiteljica", "sl": "Super. Naredite vajo dve.", "de": "Super. Machen Sie Übung zwei." }
      ]
    },
    {
      "id": "d-kaj-je-to",
      "type": "dialog",
      "title": "Was ist das?",
      "speakers": ["Rok", "Nina"],
      "lines": [
        { "speaker": "Rok", "sl": "Nina, kaj je to?", "de": "Nina, was ist das?" },
        { "speaker": "Nina", "sl": "To je moj {{0}}.", "answer": "slovar", "distractor": "knjiga", "de": "Das ist mein Wörterbuch." },
        { "speaker": "Rok", "sl": "A je slovensko-nemški?", "de": "Ist es slowenisch-deutsch?" },
        { "speaker": "Nina", "sl": "Ja, {{0}}.", "answer": "je", "distractor": "ni", "de": "Ja, ist es." },
        { "speaker": "Rok", "sl": "Kako se reče »Fenster« po slovensko?", "de": "Wie sagt man »Fenster« auf Slowenisch?" },
        { "speaker": "Nina", "sl": "{{0}}.", "answer": "Okno", "distractor": "Vrata", "de": "Fenster." },
        { "speaker": "Rok", "sl": "In kdo je to na sliki?", "de": "Und wer ist das auf dem Bild?" },
        { "speaker": "Nina", "sl": "Ne {{0}}. Mogoče je to učitelj.", "answer": "vem", "distractor": "veš", "de": "Ich weiß es nicht. Vielleicht ist das der Lehrer." }
      ]
    },
    {
      "id": "d-nov-v-razredu",
      "type": "dialog",
      "title": "Neu in der Klasse",
      "speakers": ["Sara", "Ivan"],
      "lines": [
        { "speaker": "Sara", "sl": "Živjo! A si ti nov v razredu?", "de": "Hallo! Bist du neu in der Klasse?" },
        { "speaker": "Ivan", "sl": "Ja. Jaz sem Ivan, iz Hrvaške. Star {{0}} 25 let.", "answer": "sem", "distractor": "si", "de": "Ja. Ich bin Ivan, aus Kroatien. Ich bin 25 Jahre alt." },
        { "speaker": "Sara", "sl": "Jaz sem Sara. Ti je Slovenija všeč?", "de": "Ich bin Sara. Gefällt dir Slowenien?" },
        { "speaker": "Ivan", "sl": "Ja, zelo. Ampak slovensko {{0}} samo malo.", "answer": "govorim", "distractor": "govoriš", "de": "Ja, sehr. Aber ich spreche nur ein bisschen Slowenisch." },
        { "speaker": "Sara", "sl": "Ni problema. Kakšna je tvoja telefonska številka?", "de": "Kein Problem. Wie ist deine Telefonnummer?" },
        { "speaker": "Ivan", "sl": "Nič štiri ena, tri dva {{0}}, ena pet sedem.", "answer": "šest", "distractor": "sedem", "de": "041 326 157" },
        { "speaker": "Sara", "sl": "Hvala. Se vidiva jutri!", "de": "Danke. Wir sehen uns morgen!" },
        { "speaker": "Ivan", "sl": "Ja, do jutri!", "de": "Ja, bis morgen!" }
      ]
    }
