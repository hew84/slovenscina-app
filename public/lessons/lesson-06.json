    {
      "id": "d-pot",
      "type": "dialog",
      "title": "Nach dem Weg fragen",
      "speakers": ["Turistka", "Gospod"],
      "lines": [
        { "speaker": "Turistka", "sl": "Oprostite, kje je železniška postaja?", "de": "Entschuldigung, wo ist der Bahnhof?" },
        { "speaker": "Gospod", "sl": "Ni daleč. Greste {{0}} do semaforja.", "answer": "naravnost", "distractor": "nazaj", "de": "Es ist nicht weit. Sie gehen geradeaus bis zur Ampel." },
        { "speaker": "Turistka", "sl": "In potem?", "de": "Und dann?" },
        { "speaker": "Gospod", "sl": "Pri semaforju {{0}}. Postaja je tam.", "answer": "levo", "distractor": "levi", "de": "An der Ampel links. Der Bahnhof ist dort." },
        { "speaker": "Turistka", "sl": "A je tukaj blizu tudi kakšen bankomat?", "de": "Gibt es hier in der Nähe auch einen Geldautomaten?" },
        { "speaker": "Gospod", "sl": "Ja, bankomat je {{0}} postaje.", "answer": "blizu", "distractor": "daleč", "de": "Ja, der Geldautomat ist in der Nähe des Bahnhofs." },
        { "speaker": "Turistka", "sl": "Najlepša hvala!", "de": "Vielen herzlichen Dank!" },
        { "speaker": "Gospod", "sl": "Ni za {{0}}. Nasvidenje!", "answer": "kaj", "distractor": "kdo", "de": "Keine Ursache. Auf Wiedersehen!" }
      ]
    },
    {
      "id": "d-obisk",
      "type": "dialog",
      "title": "Besuch in der WG",
      "speakers": ["Luka", "Eva"],
      "lines": [
        { "speaker": "Luka", "sl": "Živjo, Eva! Izvoli {{0}}.", "answer": "naprej", "distractor": "nazaj", "de": "Hallo, Eva! Komm herein." },
        { "speaker": "Eva", "sl": "Hvala. Vau, stanovanje je zelo veliko!", "de": "Danke. Wow, die Wohnung ist sehr groß!" },
        { "speaker": "Luka", "sl": "Ja, in ima dve {{0}} sobi.", "answer": "veliki", "distractor": "velike", "de": "Ja, und sie hat zwei große Zimmer." },
        { "speaker": "Eva", "sl": "Kdo je to na sliki?", "de": "Wer ist das auf dem Bild?" },
        { "speaker": "Luka", "sl": "To {{0}} moja sostanovalca, Jure in Tim.", "answer": "sta", "distractor": "so", "de": "Das sind meine beiden Mitbewohner, Jure und Tim." },
        { "speaker": "Eva", "sl": "Sta simpatična?", "de": "Sind die beiden nett?" },
        { "speaker": "Luka", "sl": "Ja, zelo. In tukaj blizu je dobra {{0}}!", "answer": "slaščičarna", "distractor": "slaščičarne", "de": "Ja, sehr. Und hier in der Nähe ist eine gute Konditorei!" },
        { "speaker": "Eva", "sl": "Super! Gremo?", "de": "Super! Gehen wir?" }
      ]
    },
    {
      "id": "d-moja-ulica",
      "type": "dialog",
      "title": "Wo wohnst du?",
      "speakers": ["Maja", "Peter"],
      "lines": [
        { "speaker": "Maja", "sl": "Kje živiš, Peter?", "de": "Wo wohnst du, Peter?" },
        { "speaker": "Peter", "sl": "Živim v centru. Moja ulica je zelo {{0}}.", "answer": "lepa", "distractor": "lep", "de": "Ich wohne im Zentrum. Meine Straße ist sehr schön." },
        { "speaker": "Maja", "sl": "Kaj imaš blizu?", "de": "Was hast du in der Nähe?" },
        { "speaker": "Peter", "sl": "Blizu {{0}} trgovina in kavarna.", "answer": "sta", "distractor": "so", "de": "In der Nähe sind ein Geschäft und ein Café." },
        { "speaker": "Maja", "sl": "In avtobusna postaja?", "de": "Und die Bushaltestelle?" },
        { "speaker": "Peter", "sl": "Ta je žal {{0}}. Ampak parkirišče je blizu.", "answer": "daleč", "distractor": "blizu", "de": "Die ist leider weit weg. Aber der Parkplatz ist in der Nähe." },
        { "speaker": "Maja", "sl": "Jaz pa živim v študentskem domu.", "de": "Ich wohne im Studentenwohnheim." },
        { "speaker": "Peter", "sl": "A res? Je tam {{0}}?", "answer": "lepo", "distractor": "lepa", "de": "Wirklich? Ist es dort schön?" },
        { "speaker": "Maja", "sl": "Ja, in sostanovalke so zelo simpatične.", "de": "Ja, und die Mitbewohnerinnen sind sehr nett." }
      ]
    }
  ]
