    {
      "id": "d-tecaj",
      "type": "dialog",
      "title": "Erster Tag im Sprachkurs",
      "speakers": ["Luka", "Eva"],
      "lines": [
        { "speaker": "Luka", "sl": "Živjo! Jaz sem Luka.", "de": "Hallo! Ich bin Luka." },
        { "speaker": "Eva", "sl": "Živjo, Luka. Jaz sem Eva. Me veseli.", "de": "Hallo, Luka. Ich bin Eva. Freut mich." },
        { "speaker": "Luka", "sl": "Me veseli. Od kod {{0}}?", "answer": "si", "distractor": "ste", "de": "Freut mich. Woher kommst du?" },
        { "speaker": "Eva", "sl": "Iz Nemčije, iz {{0}}. Pa ti?", "answer": "Berlina", "distractor": "Berlin", "de": "Aus Deutschland, aus Berlin. Und du?" },
        { "speaker": "Luka", "sl": "Jaz sem iz Slovenije, iz Kranja.", "de": "Ich bin aus Slowenien, aus Kranj." },
        { "speaker": "Eva", "sl": "Kaj si po {{0}}?", "answer": "poklicu", "distractor": "poklic", "de": "Was bist du von Beruf?" },
        { "speaker": "Luka", "sl": "Študent sem. In ti?", "de": "Ich bin Student. Und du?" },
        { "speaker": "Eva", "sl": "Jaz sem {{0}}. Delam v hotelu.", "answer": "natakarica", "distractor": "natakar", "de": "Ich bin Kellnerin. Ich arbeite in einem Hotel." },
        { "speaker": "Luka", "sl": "Katere jezike govoriš?", "de": "Welche Sprachen sprichst du?" },
        { "speaker": "Eva", "sl": "Nemško, angleško in malo {{0}}.", "answer": "slovensko", "distractor": "slovenski", "de": "Deutsch, Englisch und ein bisschen Slowenisch." }
      ]
    },
    {
      "id": "d-recepcija",
      "type": "dialog",
      "title": "An der Rezeption",
      "speakers": ["Receptorka", "Gospod Weber"],
      "lines": [
        { "speaker": "Receptorka", "sl": "Dober dan. Kako vam je ime?", "de": "Guten Tag. Wie heißen Sie?" },
        { "speaker": "Gospod Weber", "sl": "Thomas.", "de": "Thomas." },
        { "speaker": "Receptorka", "sl": "Kako se {{0}}?", "answer": "pišete", "distractor": "pišeš", "de": "Wie ist Ihr Nachname?" },
        { "speaker": "Gospod Weber", "sl": "Weber.", "de": "Weber." },
        { "speaker": "Receptorka", "sl": "Od kod {{0}}?", "answer": "ste", "distractor": "si", "de": "Woher kommen Sie?" },
        { "speaker": "Gospod Weber", "sl": "Iz Avstrije, iz Gradca.", "de": "Aus Österreich, aus Graz." },
        { "speaker": "Receptorka", "sl": "Kaj ste po poklicu?", "de": "Was sind Sie von Beruf?" },
        { "speaker": "Gospod Weber", "sl": "Po poklicu {{0}} inženir.", "answer": "sem", "distractor": "je", "de": "Ich bin Ingenieur von Beruf." },
        { "speaker": "Receptorka", "sl": "In vaš e-naslov?", "de": "Und Ihre E-Mail-Adresse?" },
        { "speaker": "Gospod Weber", "sl": "thomas pika weber {{0}} gmail pika com.", "answer": "afna", "distractor": "pika", "de": "thomas.weber@gmail.com" },
        { "speaker": "Receptorka", "sl": "Hvala. Nasvidenje!", "de": "Danke. Auf Wiedersehen!" }
      ]
    },
    {
      "id": "d-soseda",
      "type": "dialog",
      "title": "Die neue Nachbarin",
      "speakers": ["Jan", "Maja"],
      "lines": [
        { "speaker": "Jan", "sl": "Dober večer! Si ti nova {{0}}?", "answer": "soseda", "distractor": "sosed", "de": "Guten Abend! Bist du die neue Nachbarin?" },
        { "speaker": "Maja", "sl": "Ja, jaz sem Maja. Me veseli.", "de": "Ja, ich bin Maja. Freut mich." },
        { "speaker": "Jan", "sl": "Me veseli. Jaz sem Jan. Si Slovenka?", "de": "Freut mich. Ich bin Jan. Bist du Slowenin?" },
        { "speaker": "Maja", "sl": "Ne, {{0}} Slovenka. Sem Hrvatica, iz Zagreba.", "answer": "nisem", "distractor": "ni", "de": "Nein, ich bin keine Slowenin. Ich bin Kroatin, aus Zagreb." },
        { "speaker": "Jan", "sl": "Super! Govoriš zelo dobro slovensko.", "de": "Super! Du sprichst sehr gut Slowenisch." },
        { "speaker": "Maja", "sl": "Hvala! Zdaj moram iti. Lahko {{0}}!", "answer": "noč", "distractor": "večer", "de": "Danke! Ich muss jetzt gehen. Gute Nacht!" },
        { "speaker": "Jan", "sl": "Lahko noč, Maja!", "de": "Gute Nacht, Maja!" }
      ]
    }
