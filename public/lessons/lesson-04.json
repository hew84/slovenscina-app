    {
      "id": "d-telefon",
      "type": "dialog",
      "title": "Ein Anruf in der Firma",
      "speakers": ["Petra", "Gospod Kovač"],
      "lines": [
        { "speaker": "Petra", "sl": "Podjetje Alpa, dober dan.", "de": "Firma Alpa, guten Tag." },
        { "speaker": "Gospod Kovač", "sl": "Dober dan, tukaj Kovač. Ali lahko {{0}} z gospo Novak?", "answer": "govorim", "distractor": "govori", "de": "Guten Tag, hier Kovač. Kann ich mit Frau Novak sprechen?" },
        { "speaker": "Petra", "sl": "Žal je zdaj na sestanku.", "de": "Leider ist sie gerade in einer Besprechung." },
        { "speaker": "Gospod Kovač", "sl": "Kdaj bo {{0}}?", "answer": "prosta", "distractor": "prost", "de": "Wann ist sie frei?" },
        { "speaker": "Petra", "sl": "Okoli treh. Ali ji želite pustiti sporočilo?", "de": "Gegen drei. Möchten Sie ihr eine Nachricht hinterlassen?" },
        { "speaker": "Gospod Kovač", "sl": "Ja, prosim. Naj me {{0}} nazaj.", "answer": "pokliče", "distractor": "pokličem", "de": "Ja, bitte. Sie soll mich zurückrufen." },
        { "speaker": "Petra", "sl": "Seveda. Vašo telefonsko številko, prosim.", "de": "Natürlich. Ihre Telefonnummer, bitte." },
        { "speaker": "Gospod Kovač", "sl": "041 234 567. Hvala lepa, nasvidenje.", "de": "041 234 567. Vielen Dank, auf Wiedersehen." },
        { "speaker": "Petra", "sl": "Nasvidenje.", "de": "Auf Wiedersehen." }
      ]
    },
    {
      "id": "d-sestanek",
      "type": "dialog",
      "title": "Eine Besprechung planen",
      "speakers": ["Maja", "Luka"],
      "lines": [
        { "speaker": "Maja", "sl": "Luka, imaš jutri čas za sestanek?", "de": "Luka, hast du morgen Zeit für eine Besprechung?" },
        { "speaker": "Luka", "sl": "Jutri dopoldne {{0}} zaseden. Kaj pa popoldne?", "answer": "sem", "distractor": "si", "de": "Morgen Vormittag bin ich beschäftigt. Wie wäre es am Nachmittag?" },
        { "speaker": "Maja", "sl": "Popoldne je v redu. Ob dveh?", "de": "Nachmittag passt. Um zwei?" },
        { "speaker": "Luka", "sl": "Ja, ob dveh mi {{0}}.", "answer": "ustreza", "distractor": "ustrezam", "de": "Ja, um zwei passt es mir." },
        { "speaker": "Maja", "sl": "Super. Rezervirala bom sejno {{0}}.", "answer": "sobo", "distractor": "soba", "de": "Super. Ich reserviere den Besprechungsraum." },
        { "speaker": "Luka", "sl": "Hvala. Pošlji mi sporočilo, prosim.", "de": "Danke. Schick mir bitte eine Nachricht." },
        { "speaker": "Maja", "sl": "Seveda, takoj.", "de": "Klar, sofort." }
      ]
    },
    {
      "id": "d-bolniska",
      "type": "dialog",
      "title": "Krankmeldung beim Chef",
      "speakers": ["Ana", "Gospod Horvat"],
      "lines": [
        { "speaker": "Ana", "sl": "Dober dan, gospod Horvat. Danes ne morem priti v službo.", "de": "Guten Tag, Herr Horvat. Ich kann heute nicht zur Arbeit kommen." },
        { "speaker": "Gospod Horvat", "sl": "Kaj je narobe?", "de": "Was ist los?" },
        { "speaker": "Ana", "sl": "Ne {{0}} se dobro. Imam vročino.", "answer": "počutim", "distractor": "počuti", "de": "Ich fühle mich nicht gut. Ich habe Fieber." },
        { "speaker": "Gospod Horvat", "sl": "Ostanite doma. Ste bili pri zdravniku?", "de": "Bleiben Sie zu Hause. Waren Sie beim Arzt?" },
        { "speaker": "Ana", "sl": "Ja, do petka sem na {{0}}.", "answer": "bolniški", "distractor": "bolniška", "de": "Ja, bis Freitag bin ich krankgeschrieben." },
        { "speaker": "Gospod Horvat", "sl": "V redu. Hitro se pozdravite!", "de": "In Ordnung. Gute Besserung!" },
        { "speaker": "Ana", "sl": "Hvala. Še nekaj: julija bi rada šla na {{0}}.", "answer": "dopust", "distractor": "dopustu", "de": "Danke. Noch etwas: Im Juli möchte ich in den Urlaub gehen." },
        { "speaker": "Gospod Horvat", "sl": "Ni problema. Pošljite mi prošnjo po e-pošti.", "de": "Kein Problem. Schicken Sie mir den Antrag per E-Mail." },
        { "speaker": "Ana", "sl": "Bom. Nasvidenje.", "de": "Mache ich. Auf Wiedersehen." }
      ]
    },
    {
      "id": "d-pomoc",
      "type": "dialog",
      "title": "Hilfe unter Kollegen",
      "speakers": ["Tina", "Marko"],
      "lines": [
        { "speaker": "Tina", "sl": "Marko, mi lahko {{0}}?", "answer": "pomagaš", "distractor": "pomagam", "de": "Marko, kannst du mir helfen?" },
        { "speaker": "Marko", "sl": "Seveda. Kaj potrebuješ?", "de": "Klar. Was brauchst du?" },
        { "speaker": "Tina", "sl": "Tiskalnik ne {{0}}.", "answer": "dela", "distractor": "delam", "de": "Der Drucker funktioniert nicht." },
        { "speaker": "Marko", "sl": "Poglej, ni papirja.", "de": "Schau, es ist kein Papier drin." },
        { "speaker": "Tina", "sl": "Aha, hvala! Moram fotokopirati še ta {{0}}.", "answer": "dokument", "distractor": "dokumenta", "de": "Ach so, danke! Ich muss noch dieses Dokument kopieren." },
        { "speaker": "Marko", "sl": "Greš potem z mano na malico?", "de": "Gehst du danach mit mir zur Brotzeit?" },
        { "speaker": "Tina", "sl": "Ja, z {{0}}!", "answer": "veseljem", "distractor": "veselje", "de": "Ja, gerne!" }
      ]
    }
  ]
