    {
      "id": "d-jutro",
      "type": "dialog",
      "title": "Ein hektischer Morgen",
      "speakers": ["Mama", "Luka"],
      "lines": [
        { "speaker": "Mama", "sl": "Luka, vstani! Ura je že sedem.", "de": "Luka, steh auf! Es ist schon sieben Uhr." },
        { "speaker": "Luka", "sl": "Joj, tako sem {{0}}.", "answer": "zaspan", "distractor": "zaspana", "de": "Oje, ich bin so verschlafen." },
        { "speaker": "Mama", "sl": "Hitro se umij in se obleci.", "de": "Wasch dich schnell und zieh dich an." },
        { "speaker": "Luka", "sl": "Kaj pa zajtrk?", "de": "Und das Frühstück?" },
        { "speaker": "Mama", "sl": "Zajtrk je na mizi. Danes {{0}}, vzemi dežnik.", "answer": "dežuje", "distractor": "sneži", "de": "Das Frühstück steht auf dem Tisch. Heute regnet es, nimm einen Regenschirm." },
        { "speaker": "Luka", "sl": "Kdaj gre avtobus?", "de": "Wann fährt der Bus?" },
        { "speaker": "Mama", "sl": "Ob {{0}}. Pohiti!", "answer": "osmih", "distractor": "osem", "de": "Um acht. Beeil dich!" }
      ]
    },
    {
      "id": "d-vikend",
      "type": "dialog",
      "title": "Pläne fürs Wochenende",
      "speakers": ["Nina", "Marko"],
      "lines": [
        { "speaker": "Nina", "sl": "Marko, imaš v {{0}} čas?", "answer": "soboto", "distractor": "sobota", "de": "Marko, hast du am Samstag Zeit?" },
        { "speaker": "Marko", "sl": "Dopoldne ne, igram nogomet. Popoldne pa sem {{0}}.", "answer": "prost", "distractor": "prosta", "de": "Vormittags nicht, da spiele ich Fußball. Aber nachmittags habe ich frei." },
        { "speaker": "Nina", "sl": "Super! Greva na piknik?", "de": "Super! Gehen wir zum Picknick?" },
        { "speaker": "Marko", "sl": "Z veseljem. Kakšno bo vreme?", "de": "Gerne. Wie wird das Wetter?" },
        { "speaker": "Nina", "sl": "Jasno in toplo. Temperatura bo 25 {{0}}.", "answer": "stopinj", "distractor": "stopinji", "de": "Klar und warm. Es werden 25 Grad." },
        { "speaker": "Marko", "sl": "Odlično. Kaj pa v nedeljo?", "de": "Super. Und am Sonntag?" },
        { "speaker": "Nina", "sl": "V nedeljo ponavadi {{0}} doma.", "answer": "počivam", "distractor": "počivaš", "de": "Am Sonntag ruhe ich mich normalerweise zu Hause aus." }
      ]
    },
    {
      "id": "d-anketa",
      "type": "dialog",
      "title": "Eine Umfrage",
      "speakers": ["Novinarka", "Gospa Kos"],
      "lines": [
        { "speaker": "Novinarka", "sl": "Dober dan. Kako pogosto pijete kavo?", "de": "Guten Tag. Wie oft trinken Sie Kaffee?" },
        { "speaker": "Gospa Kos", "sl": "Vsak dan, {{0}} na dan.", "answer": "dvakrat", "distractor": "dva", "de": "Jeden Tag, zweimal am Tag." },
        { "speaker": "Novinarka", "sl": "In kdaj vstanete?", "de": "Und wann stehen Sie auf?" },
        { "speaker": "Gospa Kos", "sl": "Med tednom zelo {{0}}, ob šestih.", "answer": "zgodaj", "distractor": "pozno", "de": "Unter der Woche sehr früh, um sechs." },
        { "speaker": "Novinarka", "sl": "Gledate zvečer televizijo?", "de": "Sehen Sie abends fern?" },
        { "speaker": "Gospa Kos", "sl": "{{0}}. Raje berem knjigo.", "answer": "Nikoli", "distractor": "Vedno", "de": "Nie. Ich lese lieber ein Buch." },
        { "speaker": "Novinarka", "sl": "Hvala za pogovor!", "de": "Danke für das Gespräch!" }
      ]
