    {
      "id": "d-izlet",
      "type": "dialog",
      "title": "Ein Ausflug in die Berge",
      "speakers": ["Luka", "Eva"],
      "lines": [
        { "speaker": "Luka", "sl": "Eva, kaj boš delala ta vikend?", "de": "Eva, was machst du dieses Wochenende?" },
        { "speaker": "Eva", "sl": "V soboto {{0}} delala, v nedeljo pa sem prosta.", "answer": "bom", "distractor": "bo", "de": "Am Samstag werde ich arbeiten, aber am Sonntag habe ich frei." },
        { "speaker": "Luka", "sl": "Greva v nedeljo na izlet v gore?", "de": "Machen wir am Sonntag einen Ausflug in die Berge?" },
        { "speaker": "Eva", "sl": "Z veseljem! Kdaj se {{0}}?", "answer": "dobiva", "distractor": "dobimo", "de": "Gerne! Wann treffen wir uns?" },
        { "speaker": "Luka", "sl": "Ob pol {{0}} zjutraj, pri avtobusni postaji.", "answer": "osmih", "distractor": "osem", "de": "Um halb acht morgens, an der Bushaltestelle." },
        { "speaker": "Eva", "sl": "Tako zgodaj? Ampak v redu. Kakšno bo vreme?", "de": "So früh? Aber in Ordnung. Wie wird das Wetter?" },
        { "speaker": "Luka", "sl": "Sončno. Popoldne bova lahko {{0}} v jezeru.", "answer": "plavala", "distractor": "plavali", "de": "Sonnig. Am Nachmittag können wir im See schwimmen." },
        { "speaker": "Eva", "sl": "Super, se veselim!", "de": "Super, ich freue mich!" }
      ]
    },
    {
      "id": "d-kino",
      "type": "dialog",
      "title": "Ins Kino?",
      "speakers": ["Nik", "Ana"],
      "lines": [
        { "speaker": "Nik", "sl": "Ana, greš zvečer z mano v kino?", "de": "Ana, gehst du heute Abend mit mir ins Kino?" },
        { "speaker": "Ana", "sl": "Mogoče. Kateri film?", "de": "Vielleicht. Welcher Film?" },
        { "speaker": "Nik", "sl": "Komedija. Začne se ob {{0}}.", "answer": "devetih", "distractor": "devet", "de": "Eine Komödie. Sie beginnt um neun." },
        { "speaker": "Ana", "sl": "Koliko časa traja?", "de": "Wie lange dauert sie?" },
        { "speaker": "Nik", "sl": "Dve {{0}}, od devetih do enajstih.", "answer": "uri", "distractor": "ure", "de": "Zwei Stunden, von neun bis elf." },
        { "speaker": "Ana", "sl": "Malo pozno, jutri imam izpit. Greva raje v {{0}}?", "answer": "soboto", "distractor": "sobota", "de": "Etwas spät, morgen habe ich eine Prüfung. Gehen wir lieber am Samstag?" },
        { "speaker": "Nik", "sl": "Prav. Rezerviral bom karte.", "de": "Okay. Ich reserviere die Karten." }
      ]
    },
    {
      "id": "d-hobiji",
      "type": "dialog",
      "title": "Ein Interview über Hobbys",
      "speakers": ["Novinar", "Gospa Petek"],
      "lines": [
        { "speaker": "Novinar", "sl": "Gospa Petek, kaj radi delate v prostem času?", "de": "Frau Petek, was machen Sie gern in Ihrer Freizeit?" },
        { "speaker": "Gospa Petek", "sl": "Veliko {{0}} na vrtu.", "answer": "delam", "distractor": "dela", "de": "Ich arbeite viel im Garten." },
        { "speaker": "Novinar", "sl": "Vas zanima tudi šport?", "de": "Interessiert Sie auch Sport?" },
        { "speaker": "Gospa Petek", "sl": "Ja, ob {{0}} igram tenis.", "answer": "sredah", "distractor": "sreda", "de": "Ja, mittwochs spiele ich Tennis." },
        { "speaker": "Novinar", "sl": "Kam boste šli letos na počitnice?", "de": "Wohin fahren Sie dieses Jahr in den Urlaub?" },
        { "speaker": "Gospa Petek", "sl": "Julija {{0}} šla na morje, v Piran.", "answer": "bom", "distractor": "bo", "de": "Im Juli fahre ich ans Meer, nach Piran." },
        { "speaker": "Novinar", "sl": "Za koliko časa?", "de": "Für wie lange?" },
        { "speaker": "Gospa Petek", "sl": "Od prvega do {{0}} julija.", "answer": "petnajstega", "distractor": "petnajst", "de": "Vom ersten bis zum fünfzehnten Juli." }
      ]
    }
