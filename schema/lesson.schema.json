{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SloBuddy lesson",
  "description": "Editor help for lesson files in public/lessons/. The app validates the same rules at load time (src/app/lesson-validation.ts).",
  "type": "object",
  "required": ["id", "title", "level", "vocabulary", "exercises"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Also the file name: lesson-01 → lesson-01.json" },
    "title": { "type": "string", "minLength": 1 },
    "level": { "type": "string", "minLength": 1, "examples": ["A1", "A2"] },
    "description": { "type": "string" },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sl", "de"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sl": { "type": "string", "minLength": 1, "description": "Slovenian" },
          "de": { "type": "string", "minLength": 1, "description": "German" },
          "note": { "type": "string" }
        }
      }
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "type", "vocabId"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "const": "flashcard" },
              "vocabId": { "type": "string", "description": "id of an entry in vocabulary" }
            }
          },
          {
            "type": "object",
            "required": ["id", "type", "text", "answers"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "const": "cloze" },
              "text": { "type": "string", "description": "Sentence with numbered blanks: \"Jaz {{0}} iz {{1}}.\"" },
              "answers": {
                "type": "array",
                "description": "One list of accepted spellings per blank, in the order of the placeholders.",
                "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              },
              "translation": { "type": "string", "description": "German meaning of the whole sentence, shown as a help." }
            }
          },
          {
            "type": "object",
            "required": ["id", "type", "prompt", "answers"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "const": "translate" },
              "prompt": { "type": "string", "description": "German text to translate." },
              "answers": {
                "type": "array",
                "minItems": 1,
                "description": "Accepted Slovenian spellings. The first one is shown as the solution.",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          {
            "type": "object",
            "required": ["id", "type", "text", "answer", "distractor", "translation"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "const": "choice" },
              "text": {
                "type": "string",
                "pattern": "\\{\\{0\\}\\}",
                "description": "Slovenian sentence with exactly one blank {{0}}. Read aloud with the answer filled in."
              },
              "answer": { "type": "string", "minLength": 1, "description": "The correct word." },
              "distractor": { "type": "string", "minLength": 1, "description": "The wrong word offered next to it." },
              "translation": { "type": "string", "minLength": 1, "description": "German meaning of the whole sentence." }
            }
          },
          {
            "type": "object",
            "required": ["id", "type", "speakers", "lines"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "const": "dialog" },
              "title": { "type": "string", "minLength": 1, "description": "Optional, shown above the dialog." },
              "speakers": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "string", "minLength": 1 },
                "description": "Exactly two names. The first speaks on the left, the second on the right with a slightly higher voice."
              },
              "lines": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["speaker", "sl"],
                  "additionalProperties": false,
                  "properties": {
                    "speaker": { "type": "string", "minLength": 1, "description": "One of the names in speakers." },
                    "sl": { "type": "string", "minLength": 1, "description": "Slovenian sentence, optionally with one blank {{0}}." },
                    "de": { "type": "string", "minLength": 1, "description": "German translation, shown when the sentence is tapped." },
                    "answer": { "type": "string", "minLength": 1, "description": "Only with a blank: the correct word." },
                    "distractor": { "type": "string", "minLength": 1, "description": "Only with a blank: the wrong word offered next to it." }
                  },
                  "dependencies": { "answer": ["distractor"], "distractor": ["answer"] }
                }
              }
            }
          }
        ]
      }
    }
  }
}
