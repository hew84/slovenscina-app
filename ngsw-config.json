{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/media/*.woff2",
          "/icons/*.png"
        ]
      }
    },
    {
      "name": "lessons",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/lessons/*.json"]
      }
    }
  ]
}
